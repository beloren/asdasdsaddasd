{
    "name": "pvp-extraction-simulator",
    "tree": {
        "$className": "DataModel",
        "ReplicatedFirst": {
            "LoadingScreen": {
                "$path": "src/LoadingScreen.client.lua"
            }
        },
        "ReplicatedStorage": {
            "$ignoreUnknownInstances": true,
            "Shared": {
                "$path": "src/shared"
            }
        },
        "ServerStorage": {
            "$ignoreUnknownInstances": true,
            "MapTools": {
                "$className": "Folder",
                "BuildIslandMap": {
                    "$path": "tools/BuildIslandMap.lua"
                },
                "CheckMapMarkers": {
                    "$path": "tools/CheckMapMarkers.lua"
                }
            }
        },
        "ServerScriptService": {
            "$ignoreUnknownInstances": true,
            "Server": {
                "$path": "src/server"
            }
        },
        "StarterPlayer": {
            "$ignoreUnknownInstances": true,
            "StarterPlayerScripts": {
                "$ignoreUnknownInstances": true,
                "$path": "src/client"
            }
        }
    }
}
